#MQTT_BROKER_HOST = 192.168.100.108
#MQTT_BROKER_PORT = 1883

# .env 수정 (프로젝트 루트에서)
#sed -i 's/^MQTT_BROKER_HOST=.*/MQTT_BROKER_HOST=localhost/' .env
#sed -i 's/^MQTT_BROKER_PORT=.*/MQTT_BROKER_PORT=1883/' .env

# 예: 테스트 브로커가 192.168.0.50:1883 라면
MQTT_BROKER_HOST = 192.168.0.15
MQTT_BROKER_PORT = 1883

STATUS_USE_APPLIED=true   # 보정된 값(적용값) 발행
# STATUS_USE_APPLIED=false  # 받은 원본 값 그대로 발행

LED_TSV_ORDER=0,1,2,3
LED_HW_ORDER=2,0,3,1

# ===============================
# 소프트-Kill 버튼 & 상태 LED 핀
# ===============================
GPIO_KILL_PIN=10                # 버튼 (GPIO10, 눌렀을 때 토글)
GPIO_KILL_ACTIVE_LOW=1          # 버튼 눌림=Low → 활성화
GPIO_KILL_DEBOUNCE_MS=120       # 디바운스(ms)

GPIO_LED_RED_PIN=9              # 빨강 LED
GPIO_LED_GREEN_PIN=11           # 녹색 LED
GPIO_LED_ACTIVE_HIGH=1   # 공통 캐소드(각 색상 애노드 제어) → HIGH=켜짐  ✅

# PCA9685 OE를 BCM22로 제어
PCA9685_OE_GPIO=22
PCA9685_OE_ACTIVE_LOW=1           # /OE는 Active-Low (LOW=Enable)
PCA9685_OE_DEFAULT_ENABLE=1       # 모듈 초기화 시 Enable로 둘지
